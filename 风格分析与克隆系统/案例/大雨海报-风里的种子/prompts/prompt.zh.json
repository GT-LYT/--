{
  "_meta": {
    "schema_version": "1.0",
    "package_kind": "template",
    "task_id": "T-STORM-TEMPLATE",
    "mode": "apply",
    "style_ref": {
      "id": "SP-STORM-001",
      "version": "0.1"
    },
    "required_rule_ids": [
      "R01",
      "R02",
      "R03",
      "R04",
      "R05",
      "R06"
    ],
    "variables": [
      "theme",
      "focus",
      "characters",
      "setting",
      "motion",
      "title",
      "tagline"
    ],
    "language": "zh"
  },
  "style": [
    {
      "id": "S01",
      "priority": "must",
      "rule_id": "R01",
      "text": "以深靛蓝、墨绿环境包围朱红橙金主形，浅色强调结构亮点与叙事焦点。"
    },
    {
      "id": "S02",
      "priority": "must",
      "rule_id": "R02",
      "text": "巨型近圆主形占据主要画面，放射线汇聚在中心偏下，浅色扇形路径引向下方小角色组。"
    },
    {
      "id": "S03",
      "priority": "must",
      "rule_id": "R03",
      "text": "两个小角色相互靠近，与主形形成悬殊尺度差，脸部、目光和互动清楚。"
    },
    {
      "id": "S04",
      "priority": "must",
      "rule_id": "R04",
      "text": "采用二维手绘色块、细线装饰与不均匀纸感颗粒，环境笔触局部打断主体边缘，面部保持清楚。"
    },
    {
      "id": "S05",
      "priority": "must",
      "rule_id": "R05",
      "text": "放射结构与斜向运动笔触交织，装饰取自当前主题，人物脸部和文字周围降低密度。"
    },
    {
      "id": "S06",
      "priority": "must",
      "rule_id": "R06",
      "text": "顶部安排白色书写大标题，底部安排较小的清楚白字，文字与主视觉互不遮挡。"
    }
  ],
  "character": [
    {
      "id": "C01",
      "priority": "must",
      "rule_id": null,
      "text": "主题为{{theme}}，巨型主形为{{focus}}，两个角色为{{characters}}。"
    }
  ],
  "environment": [
    {
      "id": "E01",
      "priority": "must",
      "rule_id": null,
      "text": "环境为{{setting}}，以{{motion}}承担斜向运动，近处笔触较强，远处细节较弱。"
    }
  ],
  "narrative": [
    {
      "id": "N01",
      "priority": "must",
      "rule_id": null,
      "text": "由暖色主形经放射汇聚点引向下方两位角色，以靠近、共同注视和动作联系建立情感停留点。"
    }
  ],
  "mood": [
    {
      "id": "M01",
      "priority": "must",
      "rule_id": null,
      "text": "通过环境运动和巨大尺度形成压力，通过角色的相互靠近表现陪伴。"
    }
  ],
  "technical": {
    "delivery": {
      "aspect_ratio": "2:3",
      "quantity": 1,
      "format": null,
      "text_mode": "exact",
      "exact_text": [
        "{{title}}",
        "{{tagline}}"
      ]
    },
    "instructions": [
      {
        "id": "T01",
        "priority": "must",
        "rule_id": null,
        "text": "顶端标题使用{{title}}，底部文案使用{{tagline}}，不添加其他可读文案或徽标。"
      }
    ]
  }
}
