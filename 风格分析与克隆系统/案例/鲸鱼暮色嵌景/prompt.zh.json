      "id": "S01",
      "priority": "must",
      "rule_id": "R01",
      "text": "近黑哑纹背景留出连续暗面，以单一、可辨的巨形围住微型世界，保留一两处载体结构。"
    },
    {
      "id": "S02",
      "priority": "must",
      "rule_id": "R02",
      "text": "靛紫和蓝紫建立暗面与空间，玫红连接内外光色，少量桃金和近白作峰值。细冷缘光强弱有别。"
    },
    {
      "id": "S03",
      "priority": "must",
      "rule_id": "R03",
      "text": "内景由大气色面、窄幅精细地标和较宽的前景笔触分层。局部清楚，其余简化。"
    },
    {
      "id": "S04",
      "priority": "must",
      "rule_id": "R04",
      "text": "载体以顺形薄笔塑造，内景用较厚的不透明叠笔；前景断笔顺承接面走势，飞点限于接口附近。"
    },
    {
      "id": "S05",
      "priority": "must",
      "rule_id": "R05",
      "text": "绝大部分边界可追踪，在一处可信接口逐渐消隐，让同一内光延续到外部并衰减回黑。"
    }
  ],
  "character": [
    {
      "id": "C01",
      "priority": "must",
      "rule_id": null,
      "text": "画出 {{carrier}}，以 {{identity_marks}} 保证外形可辨。"
